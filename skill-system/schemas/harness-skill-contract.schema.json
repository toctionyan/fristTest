{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-skill-contract.schema.json",
  "title": "Harness Skill Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skill", "version", "mode", "outputs"],
  "properties": {
    "schema": {"const": "harness-skill-contract@1"},
    "skill": {"$ref": "#/$defs/stableId"},
    "version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["read_only", "mutating"]},
    "inputs": {"$ref": "#/$defs/uniqueStrings"},
    "capabilities": {"$ref": "#/$defs/uniqueStrings"},
    "outputs": {
      "allOf": [
        {"$ref": "#/$defs/uniqueStrings"},
        {"minItems": 1}
      ]
    },
    "extension_type": {"$ref": "#/$defs/extensionType"},
    "extension_points": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/stableId"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/extensionType"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "mutating"}}, "required": ["mode"]},
      "then": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {"contains": {"const": "workspace.write"}}
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$"
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "extensionType": {
      "enum": ["procedure", "audit-lens", "gate", "finding-enricher", "context-provider"]
    }
  }
}
