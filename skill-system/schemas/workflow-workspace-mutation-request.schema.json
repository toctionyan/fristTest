{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/workflow-workspace-mutation-request.schema.json",
  "title": "Workflow Workspace Mutation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capability_id", "operations"],
  "properties": {
    "schema": {"const": "workflow-workspace-mutation-request@1"},
    "capability_id": {"const": "workspace.write"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/create"},
          {"$ref": "#/$defs/replace"},
          {"$ref": "#/$defs/delete"}
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!\\.git(?:/|$))(?!\\.harness(?:/|$))(?!\\.quality(?:/|$)).+$"
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "content", "content_sha256"],
      "properties": {
        "operation": {"const": "create"},
        "path": {"$ref": "#/$defs/path"},
        "content": {"type": "string"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "expected_sha256", "content", "content_sha256"],
      "properties": {
        "operation": {"const": "replace"},
        "path": {"$ref": "#/$defs/path"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "content": {"type": "string"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "expected_sha256"],
      "properties": {
        "operation": {"const": "delete"},
        "path": {"$ref": "#/$defs/path"},
        "expected_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
