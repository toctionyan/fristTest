APP_PROFILE=local
# Local pgvector Compose configuration
# Copy this file to `.env` in the deployment directory before running Compose.
# Replace POSTGRES_PASSWORD outside local development.
AGENT_POSTGRES_CONTAINER_NAME=customer-agent-postgres
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-local-only-password
POSTGRES_PORT=5432
