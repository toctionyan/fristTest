{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Skill and Product Change Contract",
  "type": "object",
  "required": [
    "schema_version",
    "change_id",
    "target_kind",
    "goal",
    "profile",
    "allowed_paths",
    "forbidden_paths",
    "invariants",
    "required_profiles",
    "writer_role",
    "review_roles",
    "review_attestations",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "target_kind": {
      "enum": [
        "diagnosis",
        "design",
        "oracle-review",
        "repair",
        "migration",
        "revert",
        "certification"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 8
    },
    "profile": {
      "enum": [
        "skill-only",
        "product-diagnosis",
        "product-design",
        "product-oracle-review",
        "product-repair",
        "product-migration",
        "product-revert",
        "product-certification",
        "certification"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "required_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "writer_role": {
      "enum": [
        "none",
        "skill-implementer",
        "product-implementer"
      ]
    },
    "review_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "scope-planner",
          "oracle-reviewer",
          "adversarial-reviewer",
          "release-judge"
        ]
      }
    },
    "decision_record": {
      "type": [
        "string",
        "null"
      ]
    },
    "variance_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "implementing",
        "review",
        "verified",
        "closed",
        "rejected"
      ]
    },
    "result": {
      "enum": [
        "PENDING",
        "CONVERGED",
        "NO_CODE_CHANGE_REQUIRED",
        "BLOCKED_BY_ENVIRONMENT",
        "ORACLE_REVIEW_REQUIRED",
        "ARCHITECTURE_REPLAN_REQUIRED",
        "REVERT_RECOMMENDED",
        "STOPPED_MAX_REPAIRS"
      ]
    },
    "review_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "decision",
          "evidence",
          "evidence_sha256",
          "recorded_at"
        ],
        "properties": {
          "role": {
            "enum": [
              "scope-planner",
              "oracle-reviewer",
              "adversarial-reviewer",
              "release-judge"
            ]
          },
          "decision": {
            "enum": [
              "PASS",
              "REJECT"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recorded_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": [
        "object",
        "null"
      ]
    },
    "closed_at": {
      "type": "string"
    },
    "affected_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_quality_mode": {
      "enum": [
        "static",
        "quick",
        "integration",
        "release"
      ]
    },
    "quality_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "initial_source_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "initial_source_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "product_validation": {
      "type": [
        "object",
        "null"
      ]
    },
    "architecture_policy_delta": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_policy_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
