{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-event-wakeup.schema.json",
  "title": "Durable external-event wake-up contracts",
  "oneOf": [
    {"$ref": "#/$defs/ingestRequest"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/reservation"},
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/runOnce"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "fileRef": {"type": "string", "pattern": "^file:(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authorityBoundary": {
      "type": "object",
      "properties": {
        "authority_effect": {"const": false},
        "completion_authority_changed": {"const": false},
        "merge_authority_changed": {"const": false}
      }
    },
    "externalWait": {
      "type": "object",
      "required": ["provider", "correlation_ref", "resume_event"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "correlation_ref": {"type": "string", "minLength": 1},
        "resume_event": {"type": "string", "minLength": 1}
      }
    },
    "ingestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "host_id", "session_id", "event", "authority_effect"],
      "properties": {
        "schema": {"const": "external-event-ingest-request@1"},
        "host_id": {"enum": ["chatgpt", "codex"]},
        "session_id": {"$ref": "#/$defs/identifier"},
        "event": {"type": "object", "minProperties": 1},
        "authority_effect": {"const": false}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event_id", "session_id", "host_id", "task_id", "workflow_id", "expected_revision", "taskrun_ref", "wait_checkpoint_sequence", "external_wait", "event", "evidence_refs", "received_at", "authority_effect", "event_sha256"],
      "properties": {
        "schema": {"const": "external-wakeup-event@1"},
        "event_id": {"$ref": "#/$defs/sha256"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "host_id": {"enum": ["chatgpt", "codex"]},
        "task_id": {"$ref": "#/$defs/identifier"},
        "workflow_id": {"$ref": "#/$defs/identifier"},
        "expected_revision": {"type": "integer", "minimum": 0},
        "taskrun_ref": {"$ref": "#/$defs/fileRef"},
        "wait_checkpoint_sequence": {"type": "integer", "minimum": 1},
        "external_wait": {"$ref": "#/$defs/externalWait"},
        "event": {"type": "object", "minProperties": 1},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "received_at": {"type": "string", "minLength": 1},
        "authority_effect": {"const": false},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event_id", "event_sha256", "session_id", "expected_revision", "created_at", "authority_effect", "reservation_sha256"],
      "properties": {
        "schema": {"const": "external-wakeup-reservation@1"},
        "event_id": {"$ref": "#/$defs/sha256"},
        "event_sha256": {"$ref": "#/$defs/sha256"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "expected_revision": {"type": "integer", "minimum": 0},
        "created_at": {"type": "string", "minLength": 1},
        "authority_effect": {"const": false},
        "reservation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event_id", "event_sha256", "session_id", "task_id", "workflow_id", "status", "delivery_method", "recovered", "pre_revision", "post_revision", "taskrun_status", "taskrun_phase", "next_action", "reason", "created_at", "authority_effect", "completion_authority_changed", "merge_authority_changed", "receipt_sha256"],
      "properties": {
        "schema": {"const": "external-wakeup-receipt@1"},
        "event_id": {"$ref": "#/$defs/sha256"},
        "event_sha256": {"$ref": "#/$defs/sha256"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "workflow_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["DELIVERED", "REJECTED_STALE", "BLOCKED_UNCERTAIN"]},
        "delivery_method": {"type": "string"},
        "recovered": {"type": "boolean"},
        "pre_revision": {"type": "integer", "minimum": 0},
        "post_revision": {"type": ["integer", "null"], "minimum": 0},
        "taskrun_status": {"type": ["string", "null"]},
        "taskrun_phase": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]},
        "created_at": {"type": "string", "minLength": 1},
        "authority_effect": {"const": false},
        "completion_authority_changed": {"const": false},
        "merge_authority_changed": {"const": false},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "event_id", "event_ref", "receipt_ref", "session_id", "task_id", "workflow_id", "next_action", "authority_effect", "completion_authority_changed", "merge_authority_changed"],
      "properties": {
        "schema": {"const": "external-wakeup-result@1"},
        "status": {"enum": ["QUEUED", "DELIVERED", "REJECTED_STALE", "BLOCKED_UNCERTAIN"]},
        "event_id": {"$ref": "#/$defs/sha256"},
        "event_ref": {"$ref": "#/$defs/fileRef"},
        "receipt_ref": {"oneOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}]},
        "session_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "workflow_id": {"$ref": "#/$defs/identifier"},
        "next_action": {"type": ["string", "null"]},
        "authority_effect": {"const": false},
        "completion_authority_changed": {"const": false},
        "merge_authority_changed": {"const": false}
      }
    },
    "runOnce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "processed", "limit", "provider_polling", "results", "authority_effect", "completion_authority_changed", "merge_authority_changed"],
      "properties": {
        "schema": {"const": "external-wakeup-run-once@1"},
        "status": {"const": "PASS"},
        "processed": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "provider_polling": {"const": false},
        "results": {"type": "array"},
        "authority_effect": {"const": false},
        "completion_authority_changed": {"const": false},
        "merge_authority_changed": {"const": false}
      }
    }
  }
}
