{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/starter-host-command.schema.json",
  "title": "Starter Host command transport",
  "oneOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "host": {
      "enum": ["chatgpt", "codex"]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_is_authority",
        "semantic_routing",
        "write_authority_granted",
        "completion_authority",
        "automatic_merge",
        "authority_effect"
      ],
      "properties": {
        "transport_is_authority": { "const": false },
        "semantic_routing": { "const": false },
        "write_authority_granted": { "const": false },
        "completion_authority": { "const": "TaskRun" },
        "automatic_merge": { "const": false },
        "authority_effect": { "const": false }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "command_id",
        "host_id",
        "operation",
        "session_id",
        "expected_revision",
        "payload",
        "authority_effect"
      ],
      "properties": {
        "schema": { "const": "starter-host-command@1" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "host_id": { "$ref": "#/$defs/host" },
        "operation": {
          "enum": [
            "OPEN",
            "READ",
            "SELECT",
            "CONFIRM",
            "START",
            "SUBMIT_HOST_RESULT",
            "RESUME_EXTERNAL",
            "RESUME_HUMAN",
            "RECONCILE"
          ]
        },
        "session_id": { "$ref": "#/$defs/identifier" },
        "expected_revision": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "payload": { "type": "object" },
        "authority_effect": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "OPEN" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "null" },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["user_request"],
                "properties": {
                  "user_request": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "READ" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "null" },
              "payload": { "type": "object", "additionalProperties": false }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "SELECT" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "integer", "minimum": 0 },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["selection"],
                "properties": { "selection": { "type": "object", "minProperties": 1 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "CONFIRM" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "integer", "minimum": 0 },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["confirmation"],
                "properties": { "confirmation": { "type": "object", "minProperties": 1 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "START" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "integer", "minimum": 0 },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["target_ref"],
                "properties": { "target_ref": { "type": "object", "minProperties": 1 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "SUBMIT_HOST_RESULT" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "integer", "minimum": 0 },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["result"],
                "properties": { "result": { "type": "object", "minProperties": 1 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "RESUME_EXTERNAL" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "integer", "minimum": 0 },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event", "evidence_refs", "correlation_ref"],
                "properties": {
                  "event": { "type": "object", "minProperties": 1 },
                  "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
                  "correlation_ref": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "RESUME_HUMAN" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "integer", "minimum": 0 },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["decision", "evidence_refs"],
                "properties": {
                  "decision": { "type": "object", "minProperties": 1 },
                  "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "RECONCILE" } } },
          "then": {
            "properties": {
              "expected_revision": { "type": "integer", "minimum": 0 },
              "payload": { "type": "object", "additionalProperties": false }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "command_id",
        "host_id",
        "operation",
        "session_id",
        "status",
        "session",
        "next_action",
        "error",
        "policy",
        "authority_effect"
      ],
      "properties": {
        "schema": { "const": "starter-host-command-response@1" },
        "command_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "host_id": { "oneOf": [{ "$ref": "#/$defs/host" }, { "type": "null" }] },
        "operation": {
          "oneOf": [
            {
              "enum": [
                "OPEN",
                "READ",
                "SELECT",
                "CONFIRM",
                "START",
                "SUBMIT_HOST_RESULT",
                "RESUME_EXTERNAL",
                "RESUME_HUMAN",
                "RECONCILE"
              ]
            },
            { "type": "null" }
          ]
        },
        "session_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "status": { "enum": ["PASS", "BLOCKED"] },
        "session": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
        "next_action": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "$ref": "#/$defs/identifier" },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "policy": { "$ref": "#/$defs/policy" },
        "authority_effect": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } } },
          "then": {
            "properties": {
              "command_id": { "$ref": "#/$defs/identifier" },
              "host_id": { "$ref": "#/$defs/host" },
              "operation": {
                "enum": [
                  "OPEN",
                  "READ",
                  "SELECT",
                  "CONFIRM",
                  "START",
                  "SUBMIT_HOST_RESULT",
                  "RESUME_EXTERNAL",
                  "RESUME_HUMAN",
                  "RECONCILE"
                ]
              },
              "session_id": { "$ref": "#/$defs/identifier" },
              "session": { "type": "object" },
              "next_action": { "type": "object" },
              "error": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "BLOCKED" } } },
          "then": {
            "properties": {
              "session": { "type": "null" },
              "next_action": { "type": "null" },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": { "$ref": "#/$defs/identifier" },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
