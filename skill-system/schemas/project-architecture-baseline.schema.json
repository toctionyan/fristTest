{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Architecture Baseline",
  "type": "object",
  "required": [
    "schema_version",
    "policy_kind",
    "policy_id",
    "baseline_revision",
    "project_version",
    "version",
    "non_variance_fields",
    "required_workspace_paths",
    "forbidden_paths",
    "core_root",
    "allowed_core_dirs",
    "allowed_core_root_modules"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "policy_kind": {
      "const": "project-architecture-baseline"
    },
    "policy_id": {
      "type": "string",
      "minLength": 3
    },
    "baseline_revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_version": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "non_variance_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "migration_delta_schema": {
      "type": "string"
    },
    "baseline_semantics": {
      "type": "string"
    },
    "required_workspace_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "core_root": {
      "type": "string"
    },
    "allowed_core_dirs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_core_root_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dependency_cycle_debt": {
      "type": "object",
      "required": [
        "mode",
        "baseline_components"
      ],
      "properties": {
        "mode": {
          "const": "ratchet"
        },
        "baseline_components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "members",
              "owner",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "members": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 4
              },
              "review_after": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
