{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-project.schema.json",
  "title": "Harness Project Declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "project_type", "commands", "write_scope"],
  "properties": {
    "schema": {"const": "harness-project@1"},
    "project_id": {"$ref": "#/$defs/stableId"},
    "project_type": {
      "enum": ["agent", "api", "cli", "library", "service", "web", "other"]
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/stableId"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "write_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "providers": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/stableId"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audit_workflow": {"$ref": "#/$defs/stableId"},
        "repair_workflow": {"$ref": "#/$defs/stableId"},
        "full_dev_workflow": {"$ref": "#/$defs/stableId"}
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$"
    }
  }
}
