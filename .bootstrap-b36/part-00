+        capture_output=True,
+        check=False,
+    )
+    if check and completed.returncode != 0:
+        detail = (completed.stderr or completed.stdout or "git command failed").strip()
+        raise ValueError(f"local-first Git identity check failed: {detail}")
+    return completed
+
