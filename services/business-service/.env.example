# Ecommerce Business Service local configuration
# Copy this file to `.env` in the same directory. Do not commit the real `.env`.

# APP_PROFILE is shared with the Agent and is the only trust-mode selector.
# Use local, preprod, or production. Protected profiles require signed actors.
APP_PROFILE=local
BUSINESS_SERVICE_HOST=127.0.0.1
BUSINESS_SERVICE_PORT=9000
BUSINESS_SERVICE_RELOAD=true
BUSINESS_DB_PATH=runtime/business-service/business.db
BUSINESS_DB_BACKEND=sqlite
# Required for BUSINESS_DB_BACKEND=postgres in preprod/production.
BUSINESS_DATABASE_URL=
# Demo records are opt-in.  CI's isolated Business database enables this;
# production must keep it false.
BUSINESS_SEED_DEMO_DATA=true
BUSINESS_SERVICE_TOKEN=dev-service-token
BUSINESS_REQUIRE_ACTOR_SIGNATURE=false
BUSINESS_ACTOR_SIGNING_SECRET=
BUSINESS_ACTOR_SIGNATURE_TTL_SECONDS=300
