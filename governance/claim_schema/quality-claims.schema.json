{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Agent Quality Claims",
  "type": "object",
  "required": ["schema_version", "target_id", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "target_id": {"type": "string", "minLength": 3},
    "requirement_catalog": {"type": "string", "minLength": 1},
    "requirement_profile": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "risk",
          "required_mode",
          "evidence_kind",
          "required_gates",
          "evidence_refs",
          "owner",
          "closure_requirement"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"},
          "statement": {"type": "string", "minLength": 8},
          "risk": {"enum": ["P0", "P1", "P2", "P3"]},
          "required_mode": {"enum": ["static", "quick", "integration", "release"]},
          "evidence_kind": {
            "enum": ["static-contract", "counterexample", "integration", "release-provenance"]
          },
          "owner": {"type": "string", "minLength": 1},
          "closure_requirement": {
            "enum": ["regression-transition", "current-pass"]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"}
          },
          "required_gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "source_claim_manifest": {
      "type": "object",
      "required": ["path", "target_id", "fingerprint"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "requirement_catalog": {"type": "string", "minLength": 1},
        "requirement_profile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
