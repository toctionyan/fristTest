{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/customer-agent/task-run.schema.json",
  "title": "Durable Task Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_kind",
    "status",
    "phase",
    "revision",
    "binding",
    "required_conditions",
    "conditions",
    "metadata",
    "checkpoints",
    "action_attempts",
    "blockers",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_kind": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "CREATED",
        "PLANNED",
        "RUNNING",
        "WAITING_EXTERNAL_RESULT",
        "FAILED_RECOVERABLE",
        "REPAIRING",
        "VALIDATING",
        "COMPLETED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "phase": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "binding": {"type": "object", "minProperties": 1},
    "required_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["satisfied", "evidence_refs", "updated_at"],
        "properties": {
          "satisfied": {"type": "boolean"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "updated_at": {"type": ["string", "null"]}
        }
      }
    },
    "metadata": {"type": "object"},
    "checkpoints": {"type": "array", "items": {"type": "object"}},
    "action_attempts": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
