{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host-skill-execution-result.schema.json",
  "title": "Host Skill Execution Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "execution_id", "request_fingerprint_sha256", "host_id", "status",
    "loaded_skill", "outcome", "output", "tool_receipts", "evidence_refs",
    "payload", "problem_ledger_ref", "authority_effect"
  ],
  "properties": {
    "schema": {"const": "host-skill-execution-result@1"},
    "execution_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "request_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "host_id": {"enum": ["chatgpt", "codex"]},
    "status": {"const": "PASS"},
    "loaded_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "outcome": {"type": "string", "minLength": 1},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "content", "sha256", "evidence_ref"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "tool_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema", "tool_call_id", "tool_name", "arguments_sha256",
          "result_sha256", "evidence_ref", "mutates", "write_authority_checked"
        ],
        "properties": {
          "schema": {"const": "host-tool-receipt@1"},
          "tool_call_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
          "tool_name": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
          "arguments_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_ref": {"type": "string", "minLength": 1},
          "mutates": {"type": "boolean"},
          "write_authority_checked": {"type": "boolean"}
        }
      }
    },
    "evidence_refs": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "payload": {"type": "object"},
    "problem_ledger_ref": {"type": ["string", "null"]},
    "authority_effect": {"const": false},
    "result_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
