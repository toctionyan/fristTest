# Customer Agent Service local configuration
# Copy this file to `.env` in the same directory. Do not commit the real `.env`.

# ---- Runtime / HTTP -------------------------------------------------------
APP_PROFILE=local
HOST=127.0.0.1
PORT=8000
AGENT_SERVICE_RELOAD=false
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- OpenAI-compatible chat model ----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# Protected real-model certification only accepts official HTTPS provider hosts.
# OpenAI: leave OPENAI_API_BASE empty and set this to openai.
# DeepSeek: OPENAI_API_BASE=https://api.deepseek.com, use a current deepseek-* model, and set this to deepseek.
REAL_MODEL_CERTIFICATION_PROVIDER=
MODEL_CALL_MAX_PER_TURN=18
MODEL_CALL_MAX_PLANNER_PER_TURN=8
MODEL_CALL_MAX_VERIFIER_PER_TURN=8
MODEL_CALL_MAX_SUPPORT_PER_TURN=2
CONVERSATION_LOCK_TTL_SECONDS=300

# ---- Enabled modules and Business Service --------------------------------
AGENT_ENABLED_MODULES=ecommerce
AGENT_BUSINESS_ADAPTER=ecommerce_http
BUSINESS_SERVICE_BASE_URL=http://127.0.0.1:9000
BUSINESS_SERVICE_TOKEN=dev-service-token
BUSINESS_SERVICE_TIMEOUT=8
BUSINESS_READ_TRANSPORT_RETRIES=2
BUSINESS_READ_RETRY_BACKOFF_MS=50
BUSINESS_REQUIRE_ACTOR_SIGNATURE=false
BUSINESS_ACTOR_SIGNING_SECRET=

# ---- Agent persistence / checkpoint --------------------------------------
AGENT_DB_BACKEND=sqlite
DATABASE_BACKEND=sqlite
AGENT_DATABASE_URL=
DATABASE_URL=
SQLITE_DB_PATH=runtime/sqlite/app.db
AGENT_DB_CREATE_SCHEMA=true
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DATABASE_URL=
CHECKPOINT_DB_PATH=runtime/sqlite/checkpoints.db
CHECKPOINT_SETUP=true
STRICT_PERSISTENCE=false
STATE_CONTRACT_MODE=audit
AGENT_REQUIRED_ALEMBIC_REVISION=0005_production_integrity

# ---- Retrieval / document ingestion --------------------------------------
RAG_BACKEND=local_sparse
RAG_COLLECTION=agent_knowledge
RAG_DATABASE_URL=
RAG_CREATE_SCHEMA=true
RAG_DEFAULT_TENANT=default
RAG_AVAILABILITY_MODE=optional
RAG_INDEX_INLINE_LOCAL=true
RAG_MAX_UPLOAD_BYTES=10485760
DOCUMENT_JOB_BACKEND=sqlite
DOCUMENT_JOB_DATABASE_URL=
DOCUMENT_JOB_CREATE_SCHEMA=false
DOCUMENT_JOB_LEASE_SECONDS=300
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_WORKER_ID=
DOCUMENT_OBJECT_STORE_BACKEND=local_filesystem
DOCUMENT_OBJECT_STORE_ROOT=runtime/document-objects
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=
DOCUMENT_S3_ENDPOINT_URL=
DOCUMENT_S3_REGION=
VECTOR_DB_PATH=runtime/vector-store/vector_store.db
UPLOAD_DIR=runtime/uploads
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.12
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# ---- Embeddings -----------------------------------------------------------
EMBEDDING_PROVIDER=local_sparse
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIM=1536
EMBEDDING_TIMEOUT=15

# ---- Qdrant (only when RAG_BACKEND=qdrant) --------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_LIST_DOCUMENT_LIMIT=1000

# ---- Authentication / web console ----------------------------------------
AGENT_REQUIRE_AUTH=false
AGENT_AUTH_PROVIDER=dev_headers
AGENT_ALLOW_INSECURE_DEV_HEADERS=true
AGENT_AUTH_TIMEOUT=5
AGENT_AUTH_USERINFO_URL=
AGENT_JWT_SECRET=
AGENT_JWT_ISSUER=
AGENT_JWT_AUDIENCE=
WEB_CONSOLE_DEV_LOGIN=true
WEB_CONSOLE_DEV_PASSWORD=123456
WEB_CONSOLE_DEV_ACCOUNTS_JSON=
WEB_CONSOLE_SESSION_SECRET=
WEB_CONSOLE_SESSION_TTL_SECONDS=28800

# ---- Runtime behavior / observability ------------------------------------
AGENT_LOOP_MAX_STEPS=6
AGENT_LOOP_MAX_SAME_CALLS=2
CAPABILITY_SEMANTIC_VERIFIER_MODE=auto
GOAL_ALIGNMENT_VERIFIER_MODE=auto
GOAL_GRANULARITY_VERIFIER_MODE=auto
ANSWER_RELEASE_ALIGNMENT_VERIFIER_MODE=auto
DEBUG_NODE_TRACE_ENABLED=true
TRACE_REDACTION_MODE=standard
TRACE_RETENTION_DAYS=30
METRICS_INTERNAL_TOKEN=
ACTION_CONFIG_DIR=action_configs
AGENT_ACTION_EXTENSION_MODULES=
