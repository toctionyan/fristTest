      "graph": {
        "start": "repair",
        "max_attempts_per_step": 8,
        "steps": {
          "repair": {
            "type": "skill",
            "use": "red-baseline-repair",
            "routes": {
              "success": "focused-test",
              "blocked": "BLOCKED_UNRECOVERABLE"
            }
          },
          "focused-test": {
            "type": "executor",
            "use": "test.run",
            "routes": {
              "green": "adversarial",
              "red": "repair",
              "blocked": "BLOCKED_UNRECOVERABLE"
            }
          },
          "adversarial": {
            "type": "skill",
            "use": "adversarial-review",
            "routes": {
              "clean": "quality",
              "findings": "repair",
              "blocked": "BLOCKED_UNRECOVERABLE"
            }
          },
          "quality": {
            "type": "gate",
            "use": "quality.evaluate",
            "routes": {
              "green": "END",
              "red": "repair",
              "blocked": "BLOCKED_UNRECOVERABLE"
            }
          }
        }
      }
    },
