      "provider_type": "executor",
      "mutates": false,
      "external_wait": false,
      "description": "Read files and metadata from the active workspace."
    },
    {
      "capability_id": "workspace.write",
      "provider_type": "executor",
      "mutates": true,
      "external_wait": false,
      "description": "Write governed workspace content; write authorization remains external to the capability resolver."
    },
    {
      "capability_id": "process.execute",
      "provider_type": "executor",
      "mutates": false,
      "external_wait": false,
      "description": "Run a deterministic local process."
    },
    {
      "capability_id": "test.run",
      "provider_type": "executor",
      "mutates": false,
      "external_wait": false,
      "description": "Run deterministic test commands and return evidence."
    },
    {
      "capability_id": "quality.evaluate",
      "provider_type": "executor",
      "mutates": false,
      "external_wait": false,
      "description": "Run deterministic Quality gates; Quality remains the acceptance authority."
    },
    {
      "capability_id": "vcs.diff.read",
      "provider_type": "executor",
      "mutates": false,
      "external_wait": false,
      "description": "Read version-control diffs without binding to a hosting provider."
