      "label": "next_action_choice",
      "target": "next_action_target",
      "target.resource_type": "next_action_target_type",
      "target.order_id": "next_action_target_identity"
    }
  },
  "coverage": {
    "mode": "not_collection",
    "source_population": "verified_single_target"
  },
  "validation_mode": "strict",
  "degradation_policy": {
    "optional_semantics": "show_unavailable_and_trace",
    "identity_or_decision_semantics": "controlled_error",
    "authority_or_receipt_semantics": "block_or_reconcile"
  },
  "testing": {
    "required_levels": [
      "unit",
      "contract"
    ],
    "end_to_end_required": true,
    "release_gate_required": true,
    "coverage_evidence_required": true
  },
  "release": {
    "formal_response_eligible": true,
    "renderer_registry_key": "commerce.next_actions@1",
    "legacy_output_replaces": [
      "ecommerce.legacy.next_actions"
    ],
    "release_gate": "StructuredResultReleaseGate"
  }
